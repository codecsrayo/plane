#!/bin/sh
# graphify: rebuild knowledge graph after each commit (code-only, no LLM)
if command -v python3 >/dev/null 2>&1; then
  export GEMINI_API_KEY="${GEMINI_API_KEY:-$(grep GEMINI_API_KEY /home/nixos/plane/.env 2>/dev/null | cut -d= -f2-)}"
  export LD_LIBRARY_PATH="/nix/store/1c6pfixbahxcm6pbwwc1wf5wv48lc0hk-ld-library-path/share/nix-ld/lib:$LD_LIBRARY_PATH"
  python3 -m graphify extract . --update --backend gemini --no-viz 2>&1 | tail -3 &
fi
