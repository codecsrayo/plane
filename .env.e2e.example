# ----------------------------------------------------------
# Plane — Configuracion de pruebas E2E (Playwright)
# Copia este archivo a `.env.e2e` y ajusta los valores.
# El Taskfile lo carga automaticamente para todas las tareas e2e:*
# ----------------------------------------------------------

# Base URL del backend bajo prueba.
# Helpers concatenan `/api/health`, `/auth/sign-in`, `/api/workspaces`, etc.
# - Local (containers dev):    http://localhost:8000
# - Despliegue codecsrayo:     https://plane.codecsrayo.com
API_BASE_URL=https://plane.codecsrayo.com

# Credenciales del usuario E2E. Si no existe se crea con sign-up.
# Sugerencia: usar un email dedicado para tests, no reutilizar cuentas reales.
E2E_EMAIL=e2e-runner@plane-test.local
E2E_PASSWORD=PlaneE2E!2024

# ----------------------------------------------------------
# Bootstrap idempotente del setup de la instancia (God Mode).
#
# Plane bloquea sign-up con error_code=5000 INSTANCE_NOT_CONFIGURED hasta que
# exista al menos un admin. globalSetup llama POST /api/instances/admins/sign-up
# antes de cualquier otra cosa: si ya hay admin (5150) es no-op.
#
# Por defecto usa E2E_EMAIL / E2E_PASSWORD; sobreescribir solo si el primer
# admin debe ser un usuario distinto del runner E2E.
# ----------------------------------------------------------
# E2E_ADMIN_EMAIL=admin@plane-test.local
# E2E_ADMIN_PASSWORD=PlaneE2E!2024
E2E_ADMIN_FIRST_NAME=E2E

# Ruta del storageState con cookies de sesion. Default: state.json relativo a la app.
# E2E_STORAGE_PATH=state.json
