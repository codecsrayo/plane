# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.dev — API Rust (desarrollo)
#
# Optimizaciones de tiempo de compilación:
#   1. rust-lld (bundled)  → inyectado automáticamente por Rust 1.87+;
#                            más rápido que GNU ld, sin dependencias extra.
#   2. cargo build         → pre-compila TODAS las dependencias en el layer de imagen;
#                            Docker copia el /app/target al volumen rust_target en el
#                            primer arranque (named volume copy-on-first-use)
#   3. cargo-binstall      → instala cargo-watch como binario pre-compilado,
#                            no compila desde fuente (ahorra ~8 min en docker build)
#
# USO (desde docker-compose-dev.yml):
#   context: .\n#   dockerfile: ./apps/api_rust/Dockerfile.dev
# ─────────────────────────────────────────────────────────────────────────────

FROM rust:1.94-slim-bookworm

# ── Dependencias del sistema ──────────────────────────────────────────────────
# No se requiere clang ni mold: Rust 1.87+ usa rust-lld bundled automáticamente.
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        libpq-dev \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

# ── cargo-binstall → cargo-watch (binario pre-compilado) ─────────────────────
# cargo-binstall descarga el binario de cargo-watch desde GitHub Releases,
# evitando compilarlo desde fuente (~8 min → ~20 s).
RUN curl -fsSL \
    https://github.com/cargo-bins/cargo-binstall/releases/latest/download/cargo-binstall-x86_64-unknown-linux-musl.tgz \
    | tar -xz -C /usr/local/cargo/bin/ \
    && cargo binstall cargo-watch@8.5.3 --no-confirm --locked

WORKDIR /app

# Paralelismo explícito — sobreescribible con CARGO_BUILD_JOBS=N en compose/host
ENV CARGO_BUILD_JOBS=8

# ── Caché de dependencias ─────────────────────────────────────────────────────
COPY apps/api_rust/.cargo ./.cargo
COPY apps/api_rust/Cargo.toml apps/api_rust/Cargo.lock ./
COPY apps/api_rust/migration/Cargo.toml ./migration/

# PRE-COMPILAR todas las dependencias (no solo descargar).
RUN mkdir -p src migration/src && \
    echo 'fn main() {}' > src/main.rs && \
    touch migration/src/lib.rs && \
    echo 'fn main() {}' > migration/src/main.rs && \
    cargo build && \
    rm -rf src migration/src

EXPOSE 8001

CMD ["cargo", "watch", \
     "--watch", "src", \
     "--watch", "Cargo.toml", \
     "--watch", "migration/src", \
     "-x", "run"]
