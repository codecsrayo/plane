# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.dev — API Rust (desarrollo)
#
# Optimizaciones de tiempo de compilación:
#   1. rust-lld (bundled)  → inyectado automáticamente por Rust 1.87+;
#                            más rápido que GNU ld, sin dependencias extra.
#   2. cargo build         → pre-compila TODAS las dependencias en el layer de imagen;
#                            Docker copia el /app/target al volumen rust_target en el
#                            primer arranque (named volume copy-on-first-use)
#   3. cargo-binstall      → instala cargo-watch como binario pre-compilado,
#                            no compila desde fuente (ahorra ~8 min en docker build)
#
# USO (desde docker-compose-dev.yml):
#   context: .\n#   dockerfile: ./apps/api_rust/Dockerfile.dev
# ─────────────────────────────────────────────────────────────────────────────

FROM rust:1.94-slim-bookworm

# ── Dependencias del sistema ──────────────────────────────────────────────────
# No se requiere clang ni mold: Rust 1.87+ usa rust-lld bundled automáticamente.
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        libpq-dev \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

# ── cargo-binstall → cargo-watch (binario pre-compilado) ─────────────────────
# cargo-binstall descarga el binario de cargo-watch desde GitHub Releases,
# evitando compilarlo desde fuente (~8 min → ~20 s).
RUN curl -fsSL \
    https://github.com/cargo-bins/cargo-binstall/releases/latest/download/cargo-binstall-x86_64-unknown-linux-musl.tgz \
    | tar -xz -C /usr/local/cargo/bin/ \
    && cargo binstall cargo-watch@8.5.3 --no-confirm --locked

WORKDIR /app

# Paralelismo explícito — sobreescribible con CARGO_BUILD_JOBS=N en compose/host
ENV CARGO_BUILD_JOBS=8

# ── Caché de dependencias ─────────────────────────────────────────────────────
COPY apps/api_rust/.cargo ./.cargo
COPY apps/api_rust/Cargo.toml apps/api_rust/Cargo.lock ./
COPY apps/api_rust/migration/Cargo.toml ./migration/

# PRE-COMPILAR todas las dependencias (no solo descargar).
#
# Importante: el stub de `migration/src/lib.rs` NO puede ser un archivo
# vacío — si lo es, cargo cachea metadata de un lib sin símbolos públicos
# y la primera invocación de `cargo run` desde el volumen falla con E0432
# (no `Migrator` in the root) hasta que cargo-watch detecte un cambio.
# El stub re-exporta `sea_orm_migration::prelude::*` y declara `Migrator`
# para que la metadata cacheada coincida con el lib real montado luego.
RUN mkdir -p src migration/src && \
    echo 'fn main() {}' > src/main.rs && \
    printf 'pub use sea_orm_migration::prelude::*;\npub struct Migrator;\n' \
        > migration/src/lib.rs && \
    echo 'fn main() {}' > migration/src/main.rs && \
    cargo build --workspace --lib || true

EXPOSE 8000

# Forzar salida inmediata de stdout/stderr (sin buffering)
ENV RUST_LOG=debug
ENV RUST_BACKTRACE=full

# Al arrancar el contenedor:
#   1. Limpiar SOLO los artefactos del crate `migration` del target cacheado.
#      Esto invalida la metadata stub (lib vacío) que pueda persistir en el
#      volumen `rust_target` de builds anteriores, sin tirar la cache de
#      las ~400 deps del workspace (~3 GB) que sigue siendo válida.
#   2. Lanzar cargo-watch como antes.
#
# Coste: ~2-3 s al arranque + un re-build de migration en la primera
# compilación (~5 s). Trivial frente al ahorro de no recompilar todas
# las deps cada vez (~10 min).
CMD ["sh", "-c", "rm -rf target/debug/deps/migration-* target/debug/deps/libmigration-* target/debug/.fingerprint/migration-* 2>/dev/null; cargo watch --why --watch src --watch Cargo.toml --watch migration/src -x run 2>&1"]
