---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Nosotros from '../components/Nosotros.astro';
import MisionVision from '../components/MisionVision.astro';
import Process from '../components/Process.astro';
import Servicios from '../components/Servicios.astro';
import Productos from '../components/Productos.astro';
import Trayectoria from '../components/Trayectoria.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Nav />
  <Hero />
  <Nosotros />
  <MisionVision />
  <Process />
  <Servicios />
  <Productos />
  <Trayectoria />
  <Contacto />
  <Footer />
</Layout>

<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: .14, rootMargin: '0px 0px -60px 0px' });
  document.querySelectorAll('.reveal, .mv-card').forEach(el => io.observe(el));
</script>
