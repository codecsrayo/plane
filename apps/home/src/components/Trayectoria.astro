---
---
<section id="trayectoria">
  <div class="section-head">
    <div class="section-num">06 / Trayectoria</div>
    <h2 class="section-title reveal">Más de <em>diecisiete años</em> entregando valor.</h2>
  </div>

  <div class="tl-grid">
    <div class="timeline">
      <div class="tl-item reveal d1">
        <div class="yr">2008 · Fundación</div>
        <h4>Nace Bi-Quare Consulting</h4>
        <p>Un equipo humano con alto nivel de experiencia y capacidad para entender las particularidades de cada organización dentro de un entorno globalizado y competitivo.</p>
      </div>
      <div class="tl-item reveal d2">
        <div class="yr">2010 — 2015 · Expansión</div>
        <h4>Consolidación en BI empresarial</h4>
        <p>Implementaciones de Data Warehouses, tableros ejecutivos y arquitecturas de información para clientes de los sectores real, financiero y solidario.</p>
      </div>
      <div class="tl-item reveal d3">
        <div class="yr">2016 — 2020 · Analítica avanzada</div>
        <h4>Business Analytics &amp; Big Data</h4>
        <p>Incorporamos analítica predictiva, minería de datos y procesamiento de grandes volúmenes en ambientes distribuidos, llevando a nuestros clientes del reporte a la predicción.</p>
      </div>
      <div class="tl-item reveal d4">
        <div class="yr">2021 — Hoy · Riesgos &amp; Cumplimiento</div>
        <h4>Productos propios de Gestión de Riesgos y SARLAFT</h4>
        <p>Soluciones empaquetadas para acompañar a las organizaciones en el cumplimiento normativo y la gestión integral del riesgo.</p>
      </div>
    </div>

    <aside>
      <div class="tl-item" style="padding-left:0">
        <h4 style="font-size:30px;margin-top:0">Sectores atendidos</h4>
        <p>Hemos acompañado a organizaciones de múltiples industrias, integrándonos a sus equipos y culturas para entregar soluciones costo-eficientes.</p>
        <div class="sectors">
          <span>Financiero</span><span>Solidario</span><span>Real</span>
          <span>Servicios</span><span>Salud</span><span>Retail</span>
          <span>Gobierno</span><span>Telco</span>
        </div>
      </div>

      <div class="tl-item" style="padding-left:0;margin-top:48px">
        <h4 style="font-size:30px;margin-top:0">Principios que nos guían</h4>
        <div class="sectors">
          <span>Entender antes de proponer</span>
          <span>Soluciones a la medida</span>
          <span>Costo-eficiencia</span>
          <span>Calidad integral</span>
          <span>Crecimiento del equipo</span>
        </div>
      </div>
    </aside>
  </div>

  <!-- Clients -->
  <div class="clients-block reveal">
    <div class="clients-head">
      <div>
        <div class="kicker">Nuestra trayectoria</div>
        <h3>Organizaciones que confían en <em>nuestro trabajo</em>.</h3>
      </div>
      <div class="clients-filters" role="tablist" aria-label="Filtrar clientes por categoría">
        <button class="cf-btn is-active" data-cat="all">Todos <span class="n">19</span></button>
        <button class="cf-btn" data-cat="riesgos">Administración Riesgos <span class="n">9</span></button>
        <button class="cf-btn" data-cat="bi">BI · Analytics <span class="n">6</span></button>
        <button class="cf-btn" data-cat="software">Software <span class="n">4</span></button>
      </div>
    </div>

    <div class="clients-grid" id="clientsGrid">
      <div class="client-cell featured" data-cat="riesgos">
        <div class="ct-tag">Caso · SARLAFT</div>
        <div class="f-logo"><img src="/assets/clients/confiar.png" alt="Confiar Cooperativa Financiera"/></div>
        <h4 class="f-ttl">Soluciones contra el lavado de activos</h4>
        <p class="f-desc">Segmentación, alertamiento y calibración de modelos SARLAFT, con implementación de modelo de calidad de datos.</p>
        <ul>
          <li>KNIME</li><li>MSSQL</li><li>Airflow</li><li>API</li><li>Power BI</li>
        </ul>
      </div>

      <div class="client-cell" data-cat="riesgos"><img src="/assets/clients/cootrafa.svg" alt="Cootrafa"/><div class="ct-tag">Riesgos</div><div class="ct-name">Cootrafa</div></div>
      <div class="client-cell" data-cat="riesgos"><img src="/assets/clients/afroamericana.png" alt="Afroamericana Cooperativa"/><div class="ct-tag">Riesgos</div><div class="ct-name">Afroamericana</div></div>
      <div class="client-cell" data-cat="riesgos"><img src="/assets/clients/codenet.jpg" alt="Codenet"/><div class="ct-tag">Riesgos</div><div class="ct-name">Codenet</div></div>
      <div class="client-cell" data-cat="riesgos"><img src="/assets/clients/comfamigos.png" alt="Comfamigos"/><div class="ct-tag">Riesgos</div><div class="ct-name">Comfamigos</div></div>
      <div class="client-cell" data-cat="riesgos"><img src="/assets/clients/comsab.png" alt="Comsab"/><div class="ct-tag">Riesgos</div><div class="ct-name">Comsab</div></div>
      <div class="client-cell" data-cat="riesgos"><img src="/assets/clients/pronostica.png" alt="Pronóstica"/><div class="ct-tag">Riesgos</div><div class="ct-name">Pronóstica</div></div>
      <div class="client-cell" data-cat="riesgos"><img src="/assets/clients/femont.png" alt="Femont"/><div class="ct-tag">Riesgos</div><div class="ct-name">Femont</div></div>
      <div class="client-cell" data-cat="riesgos"><img src="/assets/clients/coimpresores.png" alt="Coimpresores de Colombia"/><div class="ct-tag">Riesgos</div><div class="ct-name">Coimpresores</div></div>

      <div class="client-cell" data-cat="bi"><img src="/assets/clients/argos.png" alt="Argos"/><div class="ct-tag">BI</div><div class="ct-name">Argos</div></div>
      <div class="client-cell" data-cat="bi"><img src="/assets/clients/maaji.png" alt="Maaji"/><div class="ct-tag">BI</div><div class="ct-name">Maaji</div></div>
      <div class="client-cell" data-cat="bi"><img src="/assets/clients/coltabaco.jpg" alt="Coltabaco"/><div class="ct-tag">BI</div><div class="ct-name">Coltabaco</div></div>
      <div class="client-cell" data-cat="bi"><img src="/assets/clients/elcolombiano.jpeg" alt="El Colombiano"/><div class="ct-tag">BI</div><div class="ct-name">El Colombiano</div></div>
      <div class="client-cell" data-cat="bi"><img src="/assets/clients/solla.png" alt="Solla Nutrición Animal"/><div class="ct-tag">BI</div><div class="ct-name">Solla</div></div>
      <div class="client-cell" data-cat="bi"><img src="/assets/clients/diyotta.jpg" alt="Diyotta"/><div class="ct-tag">BI</div><div class="ct-name">Diyotta</div></div>

      <div class="client-cell" data-cat="software"><img src="/assets/clients/aliassmith.png" alt="Alias Smith"/><div class="ct-tag">Software</div><div class="ct-name">Alias/Smith</div></div>
      <div class="client-cell" data-cat="software"><img src="/assets/clients/icontec.png" alt="Icontec"/><div class="ct-tag">Software</div><div class="ct-name">Icontec</div></div>
      <div class="client-cell" data-cat="software"><img src="/assets/clients/jfk.png" alt="JFK Cooperativa Financiera"/><div class="ct-tag">Software</div><div class="ct-name">JFK Cooperativa</div></div>
      <div class="client-cell" data-cat="software"><img src="/assets/clients/bna.png" alt="Bolsa Nacional Agropecuaria"/><div class="ct-tag">Software</div><div class="ct-name">BNA</div></div>
    </div>

    <div class="clients-foot">
      <p class="cf-note">Contamos con amplia experiencia en la implementación de nuestro portafolio de soluciones integrales, en diversos sectores económicos — financiero, solidario, real, industrial y servicios.</p>
      <div class="cf-stats">
        <div><b>+19</b>Organizaciones</div>
        <div><b>+40</b>Proyectos</div>
        <div><b>8</b>Sectores</div>
      </div>
    </div>
  </div>
</section>

<script>
  (function clientsFilter() {
    const btns = document.querySelectorAll<HTMLButtonElement>('.cf-btn');
    const grid = document.getElementById('clientsGrid');
    if (!grid) return;
    const cells = grid.querySelectorAll<HTMLElement>('.client-cell');
    btns.forEach(b => b.addEventListener('click', () => {
      const cat = b.dataset.cat;
      btns.forEach(x => x.classList.toggle('is-active', x === b));
      cells.forEach(c => {
        const show = cat === 'all' || c.dataset.cat === cat;
        c.classList.toggle('is-hidden', !show);
      });
    }));
  })();
</script>
